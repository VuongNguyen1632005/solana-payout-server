# Cổng chạy ứng dụng (Render tự động gán PORT)
PORT=3000

# Solana RPC Endpoint (QuickNode, Helius, Alchemy hoặc Solana Mainnet)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Địa chỉ Contract Mint của SPL Token
MINT_ADDRESS=So11111111111111111111111111111111111111112

# Số chữ số thập phân (Decimals) của SPL Token (ví dụ: 9 hoặc 6)
TOKEN_DECIMALS=9

# Private Key của Ví Nguồn (Dạng chuỗi Base58 hoặc Mảng JSON [1,2,...])
PRIVATE_KEY=your_solana_wallet_private_key_here

# Khóa bí mật API dùng để xác thực giữa Web Hosting cPanel và Render
PAYOUT_API_KEY=your_super_secret_payout_api_key_here

# Bật/Tắt chế độ giả lập test (chỉ dùng khi test cục bộ không tốn SOL thật)
ENABLE_MOCK_PAYOUT=false
